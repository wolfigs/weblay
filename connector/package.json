{
  "name": "@wolfigs/weblay",
  "version": "0.1.0",
  "description": "Weblay connector — visual in-place editing for any website with one script tag",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wolfigs/weblay.git",
    "directory": "connector"
  },
  "files": [
    "dist"
  ],
  "main": "dist/weblay.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2020 --outfile=dist/weblay.js && npm run embed",
    "embed": "mkdir -p ../web/connector && cp dist/weblay.js ../web/connector/weblay.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
